# Banco de dados local
spring.datasource.url=jdbc:postgresql://localhost:5432/glp_client_portal
spring.datasource.username=${DB_USERNAME:postgres}
spring.datasource.password=${DB_PASSWORD}

# JPA local
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true

# Flyway fica desabilitado por padrão e é ativado no profile prod
spring.flyway.enabled=false

spring.application.name=client-portal

# Segurança
jwt.secret=${JWT_SECRET}
app.cors.allowed-origins=${APP_CORS_ALLOWED_ORIGINS:http://localhost:3000}
app.auth.cookie-secure=false
app.auth.cookie-same-site=Lax
